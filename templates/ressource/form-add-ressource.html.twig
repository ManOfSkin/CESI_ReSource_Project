{% extends 'base.html.twig' %}

 {% block stylesheets %}
     {{ encore_entry_link_tags('formAddRessource') }}
 {% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('formAddRessource') }}
{% endblock %}

{% block body %}
    {# <div id="formAddRessource"></div> #}
    {{ form_start(form) }}
    <div class="form-header">
        <img src="{{ asset('img/retour.png') }}" onclick="window.history.back()" style="cursor: pointer">
        <h1>Ajouter une ressource</h1>
    </div>
    <div class="form-body">
        <div class="row row-cols-1 row-cols-md-3">
            <div class="col mb-4">
                {{ form_label(form.libelle_ressource) }}
                {{ form_widget(form.libelle_ressource) }}
            </div>
            <div class="col mb-4">
                {{ form_label(form.categorie) }}
                {{ form_widget(form.categorie) }}
            </div>
            <div class="col mb-4">
                {{ form_label(form.type_ressource) }}
                {{ form_widget(form.type_ressource) }} 
            </div>
        </div>
        <div class="row">
            <div class="col mb-4">
                {{ form_label(form.type_relation) }}
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3">
                    {{ form_widget(form.type_relation) }}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col mb-4">
                {{ form_label(form.file) }}
                <p class="text-secondary">Taille maximale : xx Mo. Formats supportés : pdf, png, jpg, jpeg. Plusieurs fichiers possibles.</p>
                {{ form_widget(form.file) }}
            </div>
        </div>
    </div>
    <div class="form-footer">
        <div id="submit">
            {{ form_widget(form.ajouter) }}
        </div>
        {{ form_widget(form.annuler) }} 
    </div>
    {{ form_end(form) }}
{% endblock %}

